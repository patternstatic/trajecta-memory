    "package/LICENSES/CORE-MODIFICATIONS.txt",
    "package/NOTICE",
    "package/beta/DEVELOPMENT-BOUNDARY.md",
    "package/beta/src/args.js",
    "package/beta/src/canonical.js",
    "package/beta/src/cli.js",
    "package/beta/src/contracts.js",
    "package/beta/src/demo.js",
    "package/beta/src/doctor.js",
    "package/beta/src/durable-file.js",
    "package/beta/src/envelope.js",
    "package/beta/src/errors.js",
    "package/beta/src/index.js",
    "package/beta/src/kernel-port.js",
    "package/beta/src/operation-journal.js",
    "package/beta/src/receipt-store.js",
    "package/beta/src/resume-service.js",
    "package/beta/src/strict-json.js",
    "package/beta/src/target-registry.js",
    "package/beta/src/workspace.js",
    "package/beta/src/writer-lock.js",
    "package/bin/trajecta-beta",
