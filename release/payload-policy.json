{
  "schema": "trajecta.release-payload-policy/v1",
  "sourceRoots": [
    "tools/release-integrity/src/**/*.ts",
    "release/trajecta-beta.package.json",
    "release/evaluation/**/*",
    "src/**/*.ts",
    "packages/trajecta-beta/src/**/*.ts",
    "packages/trajecta-beta/bin/trajecta-beta",
    "packages/trajecta-beta/DEVELOPMENT-BOUNDARY.md",
    "LICENSE",
    "NOTICE",
    "release/payload-policy.json",
    "release/license-map.json"
  ],
  "stagedPaths": [
    "package/BETA-COMMERCIAL-TERMS.txt",
    "package/LICENSE",
    "package/LICENSES/CORE-MODIFICATIONS.txt",
    "package/NOTICE",
    "package/beta/DEVELOPMENT-BOUNDARY.md",
    "package/beta/src/args.ts",
    "package/beta/src/canonical.ts",
    "package/beta/src/cli.ts",
    "package/beta/src/contracts.ts",
    "package/beta/src/demo.ts",
    "package/beta/src/doctor.ts",
    "package/beta/src/durable-file.ts",
    "package/beta/src/envelope.ts",
    "package/beta/src/errors.ts",
    "package/beta/src/index.ts",
    "package/beta/src/kernel-port.ts",
    "package/beta/src/operation-journal.ts",
    "package/beta/src/receipt-store.ts",
    "package/beta/src/resume-service.ts",
    "package/beta/src/strict-json.ts",
    "package/beta/src/target-registry.ts",
    "package/beta/src/workspace.ts",
    "package/beta/src/writer-lock.ts",
    "package/bin/trajecta-beta",
    "package/core/src/adapters/proof/attempt-contract.ts",
    "package/core/src/adapters/proof/attempt-ledger.ts",
    "package/core/src/adapters/proof/attempt-resume.ts",
    "package/core/src/adapters/proof/receipt-renderer.ts",
    "package/core/src/index.ts",
    "package/core/src/relay.ts",
    "package/core/src/store.ts",
    "package/core/src/types.ts",
    "package/package.json"
  ],
  "exclusionList": [
    "src/cli.ts",
    "tools/release-integrity/**",
    "release/license-map.json",
    "release/trajecta-beta.package.json",
    "tools/release-integrity/test/**",
    "packages/trajecta-beta/test/**",
    "test/**",
    ".git/**",
    "node_modules/**",
    ".superpowers/**"
  ]
}
