    "package/core/src/adapters/proof/attempt-resume.js",
    "package/core/src/adapters/proof/receipt-renderer.js",
    "package/core/src/index.js",
    "package/core/src/relay.js",
    "package/core/src/store.js",
    "package/core/src/types.js",
    "package/package.json"
